# activation caches / model weights — never commit
caches/
artifacts/

# run outputs: keep result JSONs, the scripts that produced them, and notes;
# drop logs and anything else. The scripts are the record of exact
# hyperparameters, so excluding them made the experiments unreproducible.
runs/*
!runs/*/
!runs/**/*.json
!runs/*.sh
!runs/**/*.md
runs/*.log
*.npy
*.memmap
*.safetensors
*.bin

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# local config / secrets
.env
.env.*

# phase 0 scratch
paper.txt
